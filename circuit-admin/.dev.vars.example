# Copy this file to .dev.vars for npm run dev. .dev.vars is git-ignored.
# On Cloudflare, set each one with: npx wrangler secret put NAME

# The password reviewers type on the sign-in page. Use a long one.
ADMIN_PASSWORD=change-me

# Any long random text. It signs the sign-in cookie. Changing it signs everyone out.
SESSION_SECRET=replace-with-a-long-random-string

# A fine-grained GitHub token for the repository, with
# Contents: Read and write, and Actions: Read and write.
GITHUB_TOKEN=github_pat_xxx
